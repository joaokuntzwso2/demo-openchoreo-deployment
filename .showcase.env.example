# Optional local overrides for the showcase.
#
# The repository defaults are sufficient for:
#   ./demo.sh up
#
# Uncomment these for strict event/showcase qualification.

# export ENABLE_RANCHER='1'
# export RANCHER_REQUIRED='1'
# export SHOWCASE_STRICT='1'
# export SHOWCASE_REQUIRE_RANCHER='1'

# The tested clean-install cluster is:
# export OPENCHOREO_CLUSTER_NAME='openchoreo-quick-start'

# AI capabilities are optional and disabled unless explicitly configured.
# Do not commit API keys.

# Dynamic OpenChoreo Platform Artifacts portal extension
ENABLE_PLATFORM_ARTIFACTS_UI=1

# Dynamic OpenChoreo Platform Artifacts portal extension
PLATFORM_ARTIFACTS_ROLLOUT_TIMEOUT=10m
